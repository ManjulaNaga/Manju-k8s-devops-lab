apiVersion: v1
kind: Config
clusters:
  - name: devops-lab
    cluster:
      server: ${server}
      certificate-authority-data: ${ca_data}
users:
  - name: jenkins-deployer
    user:
      token: ${token}
contexts:
  - name: jenkins
    context:
      cluster: devops-lab
      user: jenkins-deployer
current-context: jenkins
